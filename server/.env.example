# ---- Required ----

# MongoDB Atlas connection string
DB_LOCATION=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mern-blog

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_ACCESS_KEY=

# Comma separated list of frontends allowed to call this API.
# Leave empty in local development to allow any origin.
CLIENT_URL=http://localhost:5173

PORT=3000

# ---- Image uploads (Cloudinary) ----
# Found on your Cloudinary dashboard. Uploads are disabled if these are unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=blogging-website

# ---- Google sign-in (Firebase) ----
# The service account JSON, base64 encoded, on a single line:
#   base64 -i serviceAccountKey.json | tr -d '\n'
# Google sign-in is disabled if this is unset.
FIREBASE_SERVICE_ACCOUNT_BASE64=
